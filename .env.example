# Copia este archivo como .env y rellénalo. NUNCA subas .env a GitHub.
# En Render no hay .env: estas mismas variables van en el panel Environment.

# ── Modelo ─────────────────────────────────────────────────────────────────────────────
# Gemini gratis: crea la clave en https://aistudio.google.com/apikey (proyecto SIN facturación).
MODELO=google:gemini-3.5-flash-lite
GEMINI_API_KEY=

# Ollama en tu equipo (no funciona en Render):
# MODELO=ollama:gemma4:e2b
# OLLAMA_BASE_URL=http://localhost:11434

# ── Telegram ───────────────────────────────────────────────────────────────────────────
# Token que te da @BotFather al crear el bot con /newbot.
TELEGRAM_TOKEN=
# Números de chat que pueden usar el bot, separados por coma. Vacío = nadie.
# Para saber el tuyo, arranca el bot y escríbele /start.
TELEGRAM_PERMITIDOS=
